{
  "name": "fps-web",
  "private": true,
  "version": "1.3.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node dev.mjs",
    "build": "npm run build -w client",
    "play": "npm run build && node play.mjs",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "test": "vitest run",
    "bot-bench": "npm run bot-bench -w server",
    "bundle-server": "node scripts/bundle-server.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.23.1": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true
  }
}
